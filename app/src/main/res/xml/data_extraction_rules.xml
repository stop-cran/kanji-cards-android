<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: cloud backup and device-to-device transfer carry progress, settings and saved drawings. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="kanji.db" />
        <include domain="database" path="kanji.db-wal" />
        <include domain="sharedpref" path="settings.xml" />
        <include domain="file" path="drawings" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="kanji.db" />
        <include domain="database" path="kanji.db-wal" />
        <include domain="sharedpref" path="settings.xml" />
        <include domain="file" path="drawings" />
    </device-transfer>
</data-extraction-rules>
